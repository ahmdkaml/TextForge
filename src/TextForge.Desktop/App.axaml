<Application xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextForge.Desktop"
    x:Class="TextForge.Desktop.App"
    RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
    <Application.Resources>
        
        <!-- Color Primitives -->
        <Color x:Key="SurfaceDarkColor">#1E1E1E</Color>
        <Color x:Key="SurfaceMediumColor">#252526</Color>
        <Color x:Key="SurfaceLightColor">#2D2D2D</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextMutedColor">#808080</Color>
        <Color x:Key="AccentColor">#007ACC</Color>
        <Color x:Key="BorderColor">#3E3E42</Color>

        <!-- Dynamic Brushes -->
        <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}" />
        <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMediumColor}" />
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="ShellAccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ShellBorderBrush" Color="{StaticResource BorderColor}" />

        <!-- Primitive Double Tokens (Width, Height, Dimensions) -->
        <x:Double x:Key="SpacingXsValue">4</x:Double>
        <x:Double x:Key="SpacingSmValue">8</x:Double>
        <x:Double x:Key="SpacingMdValue">10</x:Double>
        <x:Double x:Key="SpacingLgValue">12</x:Double>
        <x:Double x:Key="SpacingXlValue">16</x:Double>

        <!-- Thickness Tokens (Padding, Margin) -->
        <Thickness x:Key="SpacingXs">4</Thickness>
        <Thickness x:Key="SpacingSm">8</Thickness>
        <Thickness x:Key="SpacingMd">10</Thickness>
        <Thickness x:Key="SpacingLg">12</Thickness>
        <Thickness x:Key="SpacingXl">16</Thickness>

        <Thickness x:Key="PaddingContainer">8</Thickness>
        <Thickness x:Key="PaddingStatusBar">8,4</Thickness>
    </Application.Resources>
</Application>
