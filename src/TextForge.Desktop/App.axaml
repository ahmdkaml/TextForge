<Application xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextForge.Desktop"
    x:Class="TextForge.Desktop.App"
    RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
    <Application.Resources>
        <x:Double x:Key="SpacingXs">4</x:Double>
        <x:Double x:Key="SpacingSm">8</x:Double>
        <x:Double x:Key="SpacingMd">10</x:Double>
        <x:Double x:Key="SpacingLg">12</x:Double>
        <x:Double x:Key="SpacingXl">16</x:Double>

        <Thickness x:Key="PaddingContainer">8</Thickness>
        <Thickness x:Key="PaddingStatusBar">8,4</Thickness>
    </Application.Resources>
</Application>
