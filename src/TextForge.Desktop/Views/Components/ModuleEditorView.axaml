<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TextForge.Desktop.ViewModels"
             x:Class="TextForge.Desktop.Views.Components.ModuleEditorView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <!-- Self-Referencing Recursive Template for Modules & Submodules at any depth -->
        <DataTemplate x:Key="RecursiveModuleTemplate" x:DataType="vm:ModuleViewModel">
            <Border Classes="module-card"
                    Classes.selected="{Binding IsSelected}"
                    Tag="{Binding}"
                    PointerPressed="StopPropagation_PointerPressed">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"
                          HorizontalAlignment="Stretch"
                          Background="Transparent">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              Cursor="Hand"
                              PointerPressed="ModuleCard_PointerPressed">
                            <!-- Archetype Tag -->
                            <Border Grid.Column="0" Classes="archetype-tag">
                                <TextBlock Text="{Binding Name}" Classes="archetype-text" />
                            </Border>

                            <!-- Content Preview -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TruncatedPreviewContent}"
                                       Classes="preview-text" />

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Margin="4,0,0,0">
                                <Button Content="✕"
                                        Classes="action-btn delete"
                                        Command="{Binding DeleteCommand}"
                                        ToolTip.Tip="Delete Module"
                                        Tag="{Binding}" />
                                <Button Content="⊘"
                                        Classes="action-btn detach"
                                        Command="{Binding DetachCommand}"
                                        ToolTip.Tip="Detach from layout"
                                        Tag="{Binding}" />
                                <Button Content="+"
                                        Classes="action-btn clone"
                                        Command="{Binding CloneCommand}"
                                        ToolTip.Tip="Clone Module"
                                        Tag="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <StackPanel Spacing="6" Margin="4,6,4,4">
                        <TextBox Text="{Binding Content, Mode=TwoWay}"
                                 Classes="module-textbox" />

                        <!-- Recursive ItemsControl: uses the exact same template for child submodules -->
                        <ItemsControl ItemsSource="{Binding Children}"
                                      ItemTemplate="{StaticResource RecursiveModuleTemplate}"
                                      Classes="submodule-list" />
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Name="EditorScrollViewer"
                  BringIntoViewOnFocusChange="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">

        <StackPanel Name="EditorStackPanel"
                    x:DataType="vm:MainViewModel"
                    PointerPressed="DocumentRootCard_PointerPressed"
                    Classes="root-card"
                    Classes.selected="{Binding CurrentDocument.IsRootSelected}">

            <!-- Modules List -->
            <ItemsControl Name="ModuleListBox"
                          Background="Transparent"
                          ItemsSource="{Binding ModuleItems}"
                          ItemTemplate="{StaticResource RecursiveModuleTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>