<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="using:Avalonia.Controls"
             xmlns:vm="using:TextForge.Desktop.ViewModels"
             x:Class="TextForge.Desktop.Views.Components.PropertiesToolbarView"
             x:DataType="vm:MainViewModel">
    <Border Classes="properties-toolbar">
        <Grid ColumnDefinitions="* Auto" ColumnSpacing="30">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

            <!-- Consolidated Typography / Text Settings Popover -->
            <Button Name="TypographyButton"
                    Classes="toolbar-square-btn"
                    ToolTip.Tip="Typography Settings">
                <TextBlock Text="Tt" FontSize="12" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="10" Margin="4" Width="170">
                            <TextBlock Text="Typography" Classes="flyout-header" />

                            <!-- Font Family -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Font Family" Classes="flyout-label" />
                                <ComboBox Name="FontSelector"
                                          HorizontalAlignment="Stretch"
                                          Height="28"
                                          SelectedIndex="0"
                                          FontSize="12">
                                    <ComboBoxItem Content="Default" />
                                    <ComboBoxItem Content="Segoe UI" FontFamily="Segoe UI" />
                                    <ComboBoxItem Content="Inter" FontFamily="Inter" />
                                    <ComboBoxItem Content="Arial" FontFamily="Arial" />
                                    <ComboBoxItem Content="Calibri" FontFamily="Calibri" />
                                    <ComboBoxItem Content="Times New Roman" FontFamily="Times New Roman" />
                                    <ComboBoxItem Content="Consolas" FontFamily="Consolas" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Font Weight -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Weight" Classes="flyout-label" />
                                <ComboBox Name="FontWeightSelector"
                                          HorizontalAlignment="Stretch"
                                          Height="28"
                                          SelectedIndex="1"
                                          FontSize="12">
                                    <ComboBoxItem Content="Light" FontWeight="Light" />
                                    <ComboBoxItem Content="Regular" FontWeight="Normal" />
                                    <ComboBoxItem Content="Medium" FontWeight="Medium" />
                                    <ComboBoxItem Content="SemiBold" FontWeight="SemiBold" />
                                    <ComboBoxItem Content="Bold" FontWeight="Bold" />
                                    <ComboBoxItem Content="ExtraBold" FontWeight="ExtraBold" />
                                    <ComboBoxItem Content="Black" FontWeight="Black" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Font Size -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Size" Classes="flyout-label" />
                                <ComboBox Name="FontSizeSelector"
                                          HorizontalAlignment="Stretch"
                                          Height="28"
                                          SelectedIndex="3"
                                          FontSize="12">
                                    <ComboBoxItem Content="9 pt" />
                                    <ComboBoxItem Content="10 pt" />
                                    <ComboBoxItem Content="11 pt" />
                                    <ComboBoxItem Content="12 pt" />
                                    <ComboBoxItem Content="14 pt" />
                                    <ComboBoxItem Content="16 pt" />
                                    <ComboBoxItem Content="18 pt" />
                                    <ComboBoxItem Content="20 pt" />
                                    <ComboBoxItem Content="24 pt" />
                                    <ComboBoxItem Content="28 pt" />
                                    <ComboBoxItem Content="32 pt" />
                                    <ComboBoxItem Content="36 pt" />
                                    <ComboBoxItem Content="48 pt" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Section Divider -->
            <Border Classes="toolbar-divider" />

            <!-- Text Formatting Toggles (Italic & Strikethrough) -->
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Italic Toggle -->
                <ToggleButton Name="ItalicToggle"
                              Classes="toolbar-toggle-btn"
                              ToolTip.Tip="Italic">
                    <TextBlock Text="I"
                               FontSize="12"
                               FontStyle="Italic"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </ToggleButton>

                <!-- Strikethrough Toggle -->
                <ToggleButton Name="StrikethroughToggle"
                              Classes="toolbar-toggle-btn"
                              ToolTip.Tip="Strikethrough">
                    <TextBlock Text="S"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextDecorations="Strikethrough"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </ToggleButton>
            </StackPanel>

            <!-- Section Divider -->
            <Border Classes="toolbar-divider" />

            <!-- Highlight Marker Flyout Button -->
            <Button Name="HighlightMarkerButton"
                    Classes="toolbar-square-btn"
                    ToolTip.Tip="Highlight Marker">
                <TextBlock Text="🖍️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="6" Margin="4">
                            <TextBlock Text="Highlight Color" Classes="flyout-header" />

                            <WrapPanel MaxWidth="140">
                                <Button Classes="swatch-btn" Background="#FEF08A" ToolTip.Tip="Yellow" Tag="#FEF08A" />
                                <Button Classes="swatch-btn" Background="#BBF7D0" ToolTip.Tip="Green" Tag="#BBF7D0" />
                                <Button Classes="swatch-btn" Background="#FBCFE8" ToolTip.Tip="Pink" Tag="#FBCFE8" />
                                <Button Classes="swatch-btn" Background="#BAE6FD" ToolTip.Tip="Blue" Tag="#BAE6FD" />
                                <Button Classes="swatch-btn" Background="#FED7AA" ToolTip.Tip="Orange" Tag="#FED7AA" />
                                <Button Classes="swatch-btn" Background="#E5E7EB" ToolTip.Tip="Gray" Tag="#E5E7EB" />
                            </WrapPanel>

                            <Border Height="1" Background="#E5E7EB" Margin="0,2" />

                            <Button Content="None"
                                    FontSize="11"
                                    Height="24"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="Transparent"
                                    Foreground="#6B7280"
                                    Tag="None" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Text Color Flyout Popover -->
            <Button Name="TextColorButton"
                    Classes="toolbar-square-btn"
                    ToolTip.Tip="Text Color">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" />
                    <Border Width="12" Height="2" Background="#2563EB" CornerRadius="1" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="6" Margin="4">
                            <TextBlock Text="Template Colors" Classes="flyout-header" />

                            <!-- Template Palette Swatches -->
                            <WrapPanel MaxWidth="140">
                                <Button Classes="swatch-btn" Background="#2563EB" ToolTip.Tip="Primary Blue" Tag="#2563EB" />
                                <Button Classes="swatch-btn" Background="#1E40AF" ToolTip.Tip="Deep Navy" Tag="#1E40AF" />
                                <Button Classes="swatch-btn" Background="#0D9488" ToolTip.Tip="Teal Accent" Tag="#0D9488" />
                                <Button Classes="swatch-btn" Background="#4B5563" ToolTip.Tip="Slate Gray" Tag="#4B5563" />
                                <Button Classes="swatch-btn" Background="#DC2626" ToolTip.Tip="Alert Red" Tag="#DC2626" />
                            </WrapPanel>

                            <Border Height="1" Background="#E5E7EB" Margin="0,2" />

                            <!-- Custom Color Picker Control -->
                            <TextBlock Text="Custom Color" Classes="flyout-header" />
                            <cp:ColorPicker Name="CustomColorPicker"
                                            Color="#2563EB"
                                            IsAlphaEnabled="False" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </StackPanel>
            <Button Content="Clear Page" Grid.Column="1" Command="{Binding ClearAllModulesCommand}"/>
        </Grid>
    </Border>
</UserControl>