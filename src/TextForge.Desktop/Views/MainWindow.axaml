<Window xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:TextForge.Desktop.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:TextForge.Desktop.Views.Components"
        x:Class="TextForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="TextForge"
        Width="1024" Height="768"
        Focusable="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource FontSizeNormal}">

        <!-- Key Bindings -->
        <Window.KeyBindings>
                <KeyBinding Gesture="Ctrl+N"
                        Command="{Binding CommandBarViewModel.NewDocumentCommand}" />
        </Window.KeyBindings>

        <Grid RowDefinitions="Auto, *, Auto">
                <!-- Toolbar Zone - Height: Auto -->
                <components:TopCommandBarView Grid.Row="0"
                        DataContext="{Binding CommandBarViewModel}" />

                <!-- Main Content Zone - Height: * -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceDarkBrush}"
                        Padding="{StaticResource SpacingMd}">
                        <Grid ColumnDefinitions="Auto, Auto, Auto, 4*, Auto, 6*">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource SurfaceLightBrush}" Width="48">
                                        <TextBlock Text="Act"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceMediumBrush}"
                                        MaxWidth="300"><!-- Todo replace with a resource instead of
                                        hard coding and constrian the slider -->
                                        <TextBlock Text="[Sidebar / Drawer]"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>

                                <GridSplitter Grid.Column="2"
                                        Width="{StaticResource SpacingXsValue}"
                                        Background="{DynamicResource ShellBorderBrush}"
                                        ResizeDirection="Columns" />

                                <Border Grid.Column="3"
                                        Background="{DynamicResource SurfaceDarkBrush}"
                                        MinWidth="200">
                                        <TextBlock Text="[Editor Panel - 4* Space]"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>

                                <GridSplitter Grid.Column="4"
                                        Width="{StaticResource SpacingXsValue}"
                                        Background="{DynamicResource ShellBorderBrush}"
                                        ResizeDirection="Columns" />

                                <Border Grid.Column="5"
                                        Background="{DynamicResource SurfaceMediumBrush}"
                                        MinWidth="200">
                                        <TextBlock Text="[Preview Panel - 6* Space]"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>
                        </Grid>
                </Border>

                <!-- Status Bar Zone - Height: Auto -->
                <Border Grid.Row="2" Background="{DynamicResource ShellAccentBrush}"
                        Padding="{StaticResource PaddingStatusBar}">
                        <TextBlock Text="{Binding StatusMessage}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource FontSizeSmall}" />
                </Border>
        </Grid>
</Window>
