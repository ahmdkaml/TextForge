<Window xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:TextForge.Desktop.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TextForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="TextForge"
        Width="1024" Height="768"
        Focusable="True">

        <Grid RowDefinitions="Auto, *, Auto">
                <!-- Toolbar Zone - Height: Auto -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceLightBrush}"
                        Padding="{StaticResource PaddingContainer}">
                        <TextBlock Text="[Toolbar Zone - Height: Auto]"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                HorizontalAlignment="Center" />
                </Border>

                <!-- Main Content Zone - Height: * -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceDarkBrush}"
                        Padding="{StaticResource SpacingMd}">
                        <Grid ColumnDefinitions="Auto, Auto, Auto, 4*, Auto, 6*">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource SurfaceLightBrush}" Width="48">
                                        <TextBlock Text="Act"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceMediumBrush}"
                                        Width="200">
                                        <TextBlock Text="[Sidebar / Drawer]"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>

                                <GridSplitter Grid.Column="2"
                                        Width="{StaticResource SpacingXsValue}"
                                        Background="{DynamicResource ShellBorderBrush}"
                                        ResizeDirection="Columns" />

                                <Border Grid.Column="3"
                                        Background="{DynamicResource SurfaceDarkBrush}"
                                        MinWidth="200">
                                        <TextBlock Text="[Editor Panel - 4* Space]"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>

                                <GridSplitter Grid.Column="4"
                                        Width="{StaticResource SpacingXsValue}"
                                        Background="{DynamicResource ShellBorderBrush}"
                                        ResizeDirection="Columns" />

                                <Border Grid.Column="5"
                                        Background="{DynamicResource SurfaceMediumBrush}"
                                        MinWidth="200">
                                        <TextBlock Text="[Preview Panel - 6* Space]"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>
                        </Grid>
                </Border>

                <!-- Status Bar Zone - Height: Auto -->
                <Border Grid.Row="2" Background="{DynamicResource ShellAccentBrush}"
                        Padding="{StaticResource PaddingStatusBar}">
                        <TextBlock Text="{Binding StatusMessage}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource FontSizeSmall}" />
                </Border>
        </Grid>
</Window>
