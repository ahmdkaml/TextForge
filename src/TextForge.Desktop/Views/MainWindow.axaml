<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TextForge.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TextForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TextForge.Desktop">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid
        Margin="20"
        RowDefinitions="*,Auto"
        ColumnDefinitions="*,*"
        ColumnSpacing="20"
        RowSpacing="10">

        <!-- Input -->
        <TextBox
            Grid.Row="0"
            Grid.Column="0"
            Name="InputText"
            AcceptsReturn="True"
            TextChanged="InputText_TextChanged"/>

        <!-- Preview (Header removed, clean container) -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Background="White"
            Padding="20"
            BorderBrush="Gray"
            BorderThickness="1">

            <ScrollViewer>
                <TextBlock
                    Name="PreviewText"
                    TextWrapping="Wrap"/>
            </ScrollViewer>

        </Border>

        <!-- Existing button -->
        <Button
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Name="ConvertButton"
            Content="Convert to PDF"
            Click="ConvertButton_Click"/>

    </Grid>

</Window>
