<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TextForge.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TextForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/branding/icon.png"
        Title="TextForge"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP COMMAND BAR -->
        <Border Grid.Row="0" Height="44" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Background="White">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                <!-- Branding & Document Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Source="/Assets/branding/icon.png" Width="20" Height="20"/>
                    <TextBlock Text="TextForge" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Name="DocumentTitleText" Text="/ Untitled Document" VerticalAlignment="Center" Foreground="#6B7280"/>
                </StackPanel>

                <!-- Center Status -->
                <TextBlock Grid.Column="1" Text="Ready" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7280"/>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="AddModuleButton" Content="Add Module"/>
                    <Button Name="ConvertButton" Content="Export PDF" Click="ConvertButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <!-- Columns: Activity Bar | Left Drawer | Splitter | Editor & Properties (4*) | Splitter | Live Preview (6*) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,4*,4,6*">
            <!-- 1. Activity Bar (Global Nav) -->
            <Border Grid.Column="0" Width="44" BorderThickness="0,0,1,0" BorderBrush="#E5E7EB" Background="#FAFAFA">
                <StackPanel Spacing="8" Margin="4,8" HorizontalAlignment="Center">
                    <Button Name="NavOutlineBtn" Width="32" Height="32" Content="📄"
                            ToolTip.Tip="Document Outline"
                            HorizontalContentAlignment="Center" Click="NavButton_Click"/>
                    <Button Name="NavPaletteBtn" Width="32" Height="32" Content="🧩"
                            ToolTip.Tip="Module Library"
                            HorizontalContentAlignment="Center" Click="NavButton_Click"/>
                    <Button Name="NavSettingsBtn" Width="32" Height="32" Content="⚙️"
                            ToolTip.Tip="Settings"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2. Expandable Left Drawer -->
            <Border Name="LeftDrawer" Grid.Column="1"
                    Width="240"
                    IsVisible="False"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#E5E7EB"
                    Padding="10">
                <Grid>
                    <!-- Outline View -->
                    <DockPanel Name="OutlineView" IsVisible="False">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Document Outline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Click="CloseDrawer_Click"/>
                        </Grid>
                        <ListBox Name="ModuleOutlineList" Background="Transparent" BorderThickness="0"/>
                    </DockPanel>

                    <!-- Module Library / Palette View -->
                    <DockPanel Name="PaletteView" IsVisible="False">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Module Library" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Click="CloseDrawer_Click"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Drag and drop modules into the editor:" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>

                                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🏷️" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Section Heading" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Title or category separator" FontSize="10" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📝" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Paragraph Text" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Standard body copy block" FontSize="10" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💡" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Callout Box" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Highlighted tip or note" FontSize="10" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📋" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="List Container" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Ordered or bulleted list" FontSize="10" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Name="DrawerSplitter" Grid.Column="2" Width="4" ResizeDirection="Columns" IsVisible="False"/>

            <!-- 3. Module Editor & Horizontal Properties Toolbar -->
            <Border Grid.Column="3" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Section Title -->
                    <TextBlock Grid.Row="0" Text="Module Editor" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- HORIZONTAL PROPERTIES BAR -->
                    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Type & Style -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Style:" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <ComboBox Name="StyleSelector" Width="100" SelectedIndex="0">
                                    <ComboBoxItem Content="Body"/>
                                    <ComboBoxItem Content="Title"/>
                                    <ComboBoxItem Content="Heading"/>
                                    <ComboBoxItem Content="Callout"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Layout Spacing -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Margin:" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBox Name="MarginInput" Width="55" Height="28" PlaceholderText="0" Padding="4,2"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Padding:" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBox Name="PaddingInput" Width="55" Height="28" PlaceholderText="0" Padding="4,2"/>
                            </StackPanel>

                            <!-- Alignment -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="⬅" Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Align Left"/>
                                <Button Content="⬛" Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Align Center"/>
                                <Button Content="➡" Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Align Right"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Text Area -->
                    <TextBox Grid.Row="2"
                             Name="InputText"
                             AcceptsReturn="True"
                             TextChanged="InputText_TextChanged"/>
                </Grid>
            </Border>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="4" Width="4" ResizeDirection="Columns"/>

            <!-- 4. Expanded Live Preview Area (Stretches all the way to right border with preserved container padding) -->
            <Border Grid.Column="5" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Document Preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ContentControl Name="PreviewHost"
                                            Margin="0,0,0,12"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Height="24" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Background="#FAFAFA">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                <TextBlock Grid.Column="0" Text="Status: Synced" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Page 1 of 1 • 100%" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
