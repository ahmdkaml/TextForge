<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TextForge.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mod="using:TextForge.Core.Modules"
        xmlns:components="using:TextForge.Desktop.Views.Components"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TextForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/branding/icon.png"
        Title="TextForge"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ========================================== -->
        <!-- 1. TOP COMMAND BAR                         -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Classes="top-command-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Branding & Document Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Source="/Assets/branding/icon.png" Width="20" Height="20" />
                    <TextBlock Text="TextForge" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Name="DocumentTitleText" Text="/ Untitled Document" Classes="status-caption" />
                </StackPanel>

                <!-- Center Status -->
                <TextBlock Grid.Column="1" Text="Ready" HorizontalAlignment="Center" Classes="status-caption" />

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="AddModuleButton" Content="Add Module" />
                    <Button Name="ConvertButton" Content="Export PDF" Command="{Binding ExportPdfCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. MAIN WORKSPACE                          -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,4*,4,6*">

            <!-- 1. Activity Bar (Global Nav) -->
            <Border Grid.Column="0" Classes="activity-bar">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Button Name="NavOutlineBtn" Classes="nav-icon-btn" Content="📄"
                            ToolTip.Tip="Document Outline"
                            Command="{Binding ToggleTabCommand}"
                            CommandParameter="Outline" />
                    <Button Name="NavPaletteBtn" Classes="nav-icon-btn" Content="🧩"
                            ToolTip.Tip="Module Library"
                            Command="{Binding ToggleTabCommand}" 
                            CommandParameter="Palette" />
                    <Button Name="NavSettingsBtn" Classes="nav-icon-btn" Content="⚙️"
                            ToolTip.Tip="Settings" />
                </StackPanel>
            </Border>

            <!-- 2. Expandable Left Drawer -->
            <Border Name="LeftDrawer" Grid.Column="1"
                    Classes="left-drawer"
                    IsVisible="{Binding IsDrawerOpen}">
                <Grid>
                    <!-- Outline View -->
                    <DockPanel Name="OutlineView" IsVisible="{Binding ShowOutline}">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Document Outline" Classes="section-header" />
                            <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                                    Padding="0" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding CloseDrawerCommand}" />
                        </Grid>
                        <ListBox Name="ModuleOutlineList" Background="Transparent" BorderThickness="0" />
                    </DockPanel>

                    <!-- Module Library / Palette View -->
                    <DockPanel Name="PaletteView" IsVisible="{Binding ShowPalette}">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Module Library" Classes="section-header" />
                            <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                                    Padding="0" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding CloseDrawerCommand}" />
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Click a module archetype to append it to the document:"
                                           Classes="status-caption" TextWrapping="Wrap" />

                                <!-- Dynamically populated module definitions -->
                                <ItemsControl Name="AvailableModulesList" ItemsSource="{Binding AvailableModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="mod:ModuleDefinition">
                                            <Button Classes="palette-module-item"
                                                    Tag="{Binding}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddModuleCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding Description}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" Classes="palette-title" />
                                                        <TextBlock Text="{Binding Description}" Classes="palette-description" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Name="DrawerSplitter" Grid.Column="2" IsVisible="{Binding IsDrawerOpen}" />

            <!-- 3. Module Editor & Horizontal Properties Toolbar (4*) -->
            <Border Grid.Column="3" Classes="workspace-container" TextBox.TextChanged="ModuleContent_TextChanged">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Module Editor" Classes="section-header" Margin="0,0,0,8" />
                    <components:PropertiesToolbarView Grid.Row="1" Name="PropertiesToolbar" />
                    <components:ModuleEditorView Grid.Row="2" Name="ModuleEditor" />
                </Grid>
            </Border>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="4" />

            <!-- 4. Expanded Live Preview Area (6*) -->
            <components:PreviewHostView Grid.Column="5" Name="PreviewView" />

        </Grid>

        <!-- ========================================== -->
        <!-- 3. STATUS BAR                              -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Classes="status-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Name="StatusText" Text="{Binding ExportStatusMessage}" Classes="status-caption" />
                <TextBlock Grid.Column="2" Text="Page 1 of 1 • 100%" Classes="status-caption" />
            </Grid>
        </Border>

    </Grid>
</Window>