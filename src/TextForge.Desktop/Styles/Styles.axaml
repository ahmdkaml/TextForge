<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- 1. DESIGN TOKENS & RESOURCES               -->
    <!-- ========================================== -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Brand & Base Brushes -->
            <SolidColorBrush x:Key="BrandWhiteBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SubtleGrayBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="ModuleCardBackgroundBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="PreviewCanvasBackgroundBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="CardBackgroundSelectedBrush" Color="#EFF6FF" />

            <!-- Borders & Lines -->
            <SolidColorBrush x:Key="BorderGrayBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="BorderMediumGrayBrush" Color="#D1D5DB" />
            <SolidColorBrush x:Key="CardBorderSelectedBrush" Color="#2563EB" />

            <!-- Typography & Text Brushes -->
            <SolidColorBrush x:Key="TextDarkPrimaryBrush" Color="#111827" />
            <SolidColorBrush x:Key="TextDarkSecondaryBrush" Color="#1F2937" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#374151" />
            <SolidColorBrush x:Key="TextSubtleBrush" Color="#4B5563" />
            <SolidColorBrush x:Key="FaintGrayBrush" Color="#6B7280" />

            <!-- Action & Indicator Brushes -->
            <SolidColorBrush x:Key="ActionPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="ActionDeleteForegroundBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="ActionDetachForegroundBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="ActionCloneForegroundBrush" Color="#2563EB" />

            <!-- Geometry Tokens -->
            <CornerRadius x:Key="StandardCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="TagCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="SwatchCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="PageSheetCornerRadius">2</CornerRadius>

            <!-- Spacing & Padding Tokens -->
            <Thickness x:Key="StandardPadding">12</Thickness>
            <Thickness x:Key="DrawerPadding">10</Thickness>
            <Thickness x:Key="HeaderPadding">12,0</Thickness>
            <Thickness x:Key="StatusBarPadding">12,0</Thickness>
            <Thickness x:Key="ActivityBarPadding">4,8</Thickness>
            <Thickness x:Key="CardItemMargin">0,0,0,6</Thickness>
            <Thickness x:Key="ToolbarPadding">8,6</Thickness>
            <Thickness x:Key="PreviewPagePadding">36</Thickness>
            <Thickness x:Key="PreviewPageMargin">16</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ========================================== -->
    <!-- 2. UTILITY & GENERAL STYLES                -->
    <!-- ========================================== -->
    <Style Selector="GridSplitter">
        <Setter Property="Width" Value="4" />
        <Setter Property="ResizeDirection" Value="Columns" />
    </Style>

    <Style Selector="TextBlock.status-caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource FaintGrayBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ========================================== -->
    <!-- 3. MAIN WINDOW COMPONENT STYLES            -->
    <!-- ========================================== -->
    <Style Selector="Border.top-command-bar">
        <Setter Property="Height" Value="44" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="Background" Value="{DynamicResource BrandWhiteBrush}" />
        <Setter Property="Padding" Value="{DynamicResource HeaderPadding}" />
    </Style>

    <Style Selector="Border.status-bar">
        <Setter Property="Height" Value="24" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleGrayBackgroundBrush}" />
        <Setter Property="Padding" Value="{DynamicResource StatusBarPadding}" />
    </Style>

    <Style Selector="Border.activity-bar">
        <Setter Property="Width" Value="44" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleGrayBackgroundBrush}" />
        <Setter Property="Padding" Value="{DynamicResource ActivityBarPadding}" />
    </Style>

    <Style Selector="Button.nav-icon-btn">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.left-drawer">
        <Setter Property="Width" Value="240" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="Padding" Value="{DynamicResource DrawerPadding}" />
    </Style>

    <Style Selector="Button.palette-module-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource ModuleCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="{DynamicResource CardItemMargin}" />
    </Style>

    <Style Selector="TextBlock.palette-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDarkSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.palette-description">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource FaintGrayBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Border.workspace-container">
        <Setter Property="Padding" Value="{DynamicResource StandardPadding}" />
    </Style>

    <!-- ========================================== -->
    <!-- 4. MODULE EDITOR COMPONENT STYLES          -->
    <!-- ========================================== -->
    <Style Selector="Border.module-card">
        <Setter Property="Background" Value="{DynamicResource BrandWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.module-card.selected">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderSelectedBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="StackPanel.root-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="StackPanel.root-card.selected">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundSelectedBrush}" />
    </Style>

    <Style Selector="Border.archetype-tag">
        <Setter Property="Background" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TagCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="TextBlock.archetype-text">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.preview-text">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="3" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDarkSecondaryBrush}" />
    </Style>

    <Style Selector="Button.action-btn">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.action-btn.delete">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource ActionDeleteForegroundBrush}" />
    </Style>

    <Style Selector="Button.action-btn.detach">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ActionDetachForegroundBrush}" />
    </Style>

    <Style Selector="Button.action-btn.clone">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ActionCloneForegroundBrush}" />
    </Style>

    <Style Selector="TextBox.module-textbox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="45" />
    </Style>

    <Style Selector="ItemsControl.submodule-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="14,2,0,0" />
    </Style>

    <!-- ========================================== -->
    <!-- 5. PROPERTIES TOOLBAR COMPONENT STYLES     -->
    <!-- ========================================== -->
    <Style Selector="Border.properties-toolbar">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ToolbarPadding}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style Selector="Button.toolbar-square-btn">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BrandWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumGrayBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource TagCornerRadius}" />
    </Style>

    <Style Selector="ToggleButton.toolbar-toggle-btn">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.toolbar-divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{DynamicResource BorderGrayBrush}" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style Selector="TextBlock.flyout-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>

    <Style Selector="TextBlock.flyout-label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource FaintGrayBrush}" />
    </Style>

    <Style Selector="Button.swatch-btn">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource SwatchCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ========================================== -->
    <!-- 6. PREVIEW HOST COMPONENT STYLES           -->
    <!-- ========================================== -->
    <Style Selector="Border.preview-viewport">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource PreviewCanvasBackgroundBrush}" />
    </Style>

    <Style Selector="Border.a4-page-sheet">
        <Setter Property="Width" Value="595" />
        <Setter Property="MinHeight" Value="842" />
        <Setter Property="Background" Value="{DynamicResource BrandWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumGrayBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PageSheetCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource PreviewPagePadding}" />
        <Setter Property="Margin" Value="{DynamicResource PreviewPageMargin}" />
        <Setter Property="BoxShadow" Value="0 4 12 0 #20000000" />
    </Style>

    <Style Selector="ComboBox.preview-template-selector">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</Styles>