<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Root Canvas / StackPanel Card -->
    <Style Selector="StackPanel.root-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Base Module Card Border -->
    <Style Selector="Border.module-card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Selected State -->
    <Style Selector="Border.module-card:selected, Border.module-card.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderSelected}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundSelected}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Archetype Tag -->
    <Style Selector="Border.archetype-tag">
        <Setter Property="Background" Value="{DynamicResource ArchetypeTagBackground}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TagCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="TextBlock.archetype-text">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ArchetypeTagForeground}" />
    </Style>

    <!-- Action Bar & Icon Buttons -->
    <Style Selector="Button.action-btn">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.action-btn.delete">
        <Setter Property="Foreground" Value="{DynamicResource ActionDeleteForeground}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Button.action-btn.detach">
        <Setter Property="Foreground" Value="{DynamicResource ActionDetachForeground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.action-btn.clone">
        <Setter Property="Foreground" Value="{DynamicResource ActionCloneForeground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Clean Hover/Pressed overrides for action buttons -->
    <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#10000000" />
    </Style>
</Styles>